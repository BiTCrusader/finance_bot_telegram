# ============================================
# PERSONAL FINANCE BOT - Environment Variables
# ============================================
# Salin file ini menjadi .env dan isi dengan nilai yang sesuai
# JANGAN pernah commit file .env ke repository

# ---------- Telegram Bot ----------
# Dapatkan dari @BotFather di Telegram
BOT_TOKEN=

# Secret token untuk verifikasi webhook (buat sendiri, string acak)
WEBHOOK_SECRET=your_random_webhook_secret_here

# URL webhook (URL Render.com Anda)
WEBHOOK_URL=https://your-app-name.onrender.com

# ---------- Database ----------
# Connection string dari Neon PostgreSQL
DATABASE_URL=

# ---------- AI Provider ----------
# Google Gemini API Key (dapatkan dari https://aistudio.google.com/apikey)
GEMINI_API_KEY=GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Model Gemini yang digunakan (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# ---------- Access Control ----------
# Daftar Telegram ID yang diizinkan (pisahkan dengan koma)
# Contoh: 123456789,987654321
ALLOWED_TELEGRAM_IDS=

# ---------- App Settings ----------
# Port server (Render akan set otomatis)
PORT=3000

# Node environment
NODE_ENV=production

# Timezone
TZ=Asia/Makassar

# ---------- Cron Secret ----------
# Secret untuk endpoint cron (buat sendiri, string acak)
CRON_SECRET=your_cron_secret_here
